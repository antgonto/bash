# Rendered by stackctl — the gateway's only job is to be the one published port
# in front of serve (the same shape as Course 2's zero-trust proxy, minus identity).
server {
    listen 80;
    server_name _;
    location / {
        proxy_pass http://serve:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
